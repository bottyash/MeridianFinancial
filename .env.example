# ─── Meridian Financial — Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your real values.
# Never commit .env to version control.

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development                        # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO                             # DEBUG | INFO | WARNING | ERROR

# ── Paths ─────────────────────────────────────────────────────────────────────
BANK_SAMPLE_PATH=data/samples/bank_sample.csv
COMPLAINTS_SAMPLE_PATH=data/samples/complaints_sample.csv
FEATURES_ARTIFACTS_DIR=artifacts/features
CHROMA_PERSIST_DIR=chroma_store
MLFLOW_TRACKING_URI=mlruns

# ── LLM ───────────────────────────────────────────────────────────────────────
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_MODEL=mistral-small-latest

# ── Embedding Model ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_COLLECTION_NAME=complaints

# ── Ingestion ─────────────────────────────────────────────────────────────────
COMPLAINT_SAMPLE_SIZE=10000
COMPLAINT_SAMPLE_SEED=42

# ── Dashboard (Streamlit) ──────────────────────────────────────────────────────
# Set API_BASE_URL to your running FastAPI backend URL.
# Local:            http://localhost:8000
# HuggingFace Spaces: set this as a Space secret → https://your-space.hf.space
API_BASE_URL=http://localhost:8000
REQUEST_TIMEOUT=30
DASHBOARD_TITLE=Meridian Financial Intelligence

# ── HuggingFace Deployment (Active) ───────────────────────────────────────────
# Required for deploying to HuggingFace Spaces
HF_TOKEN=your-hf-write-token-here
HF_API_SPACE=bottyash/meridian-api
HF_DASH_SPACE=bottyash/meridian-dashboard

# ── AWS Deployment (Future / Planned — not currently active) ──────────────────
# These variables are documented for future production-scale AWS deployment.
# DO NOT add these to CI secrets or active deployment workflows.
# AWS_REGION=us-east-1
# DEPLOY_HOST=<ec2-public-ip>
# DEPLOY_USER=ubuntu
# DEPLOY_KEY=<path-to-ssh-key>
